#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int answer[3], guess[3];
    int strike = 0, ball = 0;

    printf("Enter 3 answer numbers (no duplicates): ");
    for (int i = 0; i < 3; i++) {
        if (scanf_s("%d", &answer[i]) != 1) {
            printf("Invalid input.\n");
            system("pause");
            return 1;
        }
    }

    printf("Enter your 3 numbers: ");
    for (int i = 0; i < 3; i++) {
        if (scanf_s("%d", &guess[i]) != 1) {
            printf("Invalid input.\n");
            system("pause");
            return 1;
        }
    }

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (guess[i] == answer[j]) {
                if (i == j) {
                    strike++;   // same number, same position
                }
                else {
                    ball++;     // same number, different position
                }
            }
        }
    }

    printf("%d Strike, %d Ball\n", strike, ball);

    if (strike == 3) {
        printf("HOMERUN\n");
    }

    system("pause");   // keep the console window open
    return 0;
}
